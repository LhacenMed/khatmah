<?xml version="1.0" encoding="utf-8"?>
<!--
  One thing a reminder can be set for, in the editor sheet's picker.

  A target that already has a reminder keeps its row rather than disappearing from the list: the
  question the list answers is "what can I be reminded about", and a surah vanishing from the
  mushaf's order because it is already set would be a harder list to read, not an easier one. It
  says so with the badge instead, and the row stops responding.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <RadioButton
        android:id="@+id/selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:duplicateParentState="true"
        android:focusable="false" />

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        tools:text="سورة الكهف" />

    <!-- Only on a target that already has a reminder, saying why its row does nothing. -->
    <TextView
        android:id="@+id/added_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/reminder_badge_bg"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="@string/reminders_already_added"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
