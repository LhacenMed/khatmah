<?xml version="1.0" encoding="utf-8"?>
<!--
  Host for Dest.screen() pages. The MaterialToolbar (shown only when the Dest sets a title)
  gives every detail screen the same native chrome as the tabs, with a platform back arrow
  that mirrors automatically in RTL. The body container holds either the Dest's Compose content
  or its native Fragment. Status-bar inset is applied in code.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Fixed top-app-bar height (matches the main tabs) so the title + subtitle share one clean
         bar without clipping (the status-bar inset is applied to the root in code, not the toolbar). -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        android:background="?attr/colorSurface"
        app:titleTextAppearance="@style/ToolbarTitleText"
        app:subtitleTextAppearance="@style/ToolbarSubtitleText" />

    <FrameLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
