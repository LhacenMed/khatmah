<?xml version="1.0" encoding="utf-8"?>
<!--
  One paragraph of a dhikr: its kind, then its text. The kind sits above the field because it
  changes the field's hint — and, once saved, how the paragraph is rendered in the reader.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/type_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/type_body"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adhkar_paragraph_body" />

            <com.google.android.material.chip.Chip
                android:id="@+id/type_quran"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adhkar_paragraph_quran" />

            <com.google.android.material.chip.Chip
                android:id="@+id/type_note"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adhkar_paragraph_note" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/paragraph_delete"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/adhkar_remove_icon"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_close"
            app:iconPadding="0dp"
            app:iconSize="16dp" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/paragraph_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:maxLines="8"
            android:minLines="3"
            android:textAppearance="@style/App.TextAppearance.BodyLarge" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
