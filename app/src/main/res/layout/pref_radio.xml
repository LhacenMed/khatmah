<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark on a chosen option row; the row itself takes the tap (see RadioPreference).

  Like the switch widget, the stock control reserves a 48dp minimum height so it can be pressed on
  its own. Nothing presses it here, so that floor is dropped and the row stands exactly as tall as
  a plain one.
-->
<RadioButton xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radio"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@null"
    android:clickable="false"
    android:duplicateParentState="true"
    android:focusable="false"
    android:minHeight="0dp"
    android:minWidth="0dp"
    android:padding="0dp" />
