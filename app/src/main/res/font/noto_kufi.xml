<?xml version="1.0" encoding="utf-8"?>
<!--
  Noto Kufi as one family, so a weight request resolves to the right face instead of to a
  synthesised bold. This is the app's default font — the base theme points `fontFamily` at it, so
  anything that doesn't ask for a specific weight (widgets, dialogs, preference rows) gets it.

  The type scale names its weights explicitly per style (see App.TextAppearance.* in themes.xml),
  because weight-by-family only resolves from API 26 and the app supports 24.
-->
<font-family
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/noto_kufi_light"
        android:fontStyle="normal"
        android:fontWeight="300"
        app:font="@font/noto_kufi_light"
        app:fontStyle="normal"
        app:fontWeight="300" />

    <font
        android:font="@font/noto_kufi_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/noto_kufi_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/noto_kufi_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/noto_kufi_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        android:font="@font/noto_kufi_semi_bold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/noto_kufi_semi_bold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        android:font="@font/noto_kufi_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/noto_kufi_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
