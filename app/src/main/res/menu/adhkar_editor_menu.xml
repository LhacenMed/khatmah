<?xml version="1.0" encoding="utf-8"?>
<!--
  Editor actions. Both are text, never icons: they commit or discard work, and a word states
  that far more clearly than a glyph. Reset appears only for a built-in category that has been
  changed; save is always present but disabled until the form is valid.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_reset"
        android:title="@string/adhkar_reset_defaults"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_save"
        android:title="@string/save"
        app:showAsAction="always" />
</menu>
