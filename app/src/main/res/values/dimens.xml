<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Native top-app-bar height. Matches the Compose Material3 TopAppBar (64dp) used by the main
         tabs, so every bar (detail hosts, book reader, reader settings) is the same height and a
         stacked title + subtitle always fits without clipping. -->
    <dimen name="top_app_bar_height">64dp</dimen>

    <!-- How much of a preference row its value may take before it truncates. Leaves the title the
         larger share on the narrowest phone the app supports, which is the point: the title names
         the setting, the value only answers it. -->
    <dimen name="pref_value_max_width">140dp</dimen>
</resources>
